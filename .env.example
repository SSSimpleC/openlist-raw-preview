# URL origin(s) used to open OpenList in the browser. Comma-separated.
# Use the exact scheme, host and port shown in the browser address bar.
RAW_PREVIEW_OPENLIST_ORIGINS=http://localhost:5244

# Optional private origin used only by the sidecar to probe/download an already
# validated signed URL. Useful when the browser uses a tunnel hostname or port
# that is not reachable from inside the container.
RAW_PREVIEW_FETCH_ORIGIN=

# 127.0.0.1 is safest when the browser is on the same machine as the sidecar.
# For a browser on another LAN device, use the server's LAN address or 0.0.0.0
# and restrict the port with the host firewall.
RAW_PREVIEW_BIND_ADDRESS=127.0.0.1
RAW_PREVIEW_PORT=5260

# Persistent JPEG cache and temporary files. Keep this on an SSD if possible.
RAW_PREVIEW_DATA_DIR=./data

# Optional JSON mapping from OpenList storage name to a read-only container path.
# The matching read-only bind mount must be added to compose.yaml or an override.
RAW_PREVIEW_SOURCE_MOUNTS={}
